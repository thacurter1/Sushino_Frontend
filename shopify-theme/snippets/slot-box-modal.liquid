<!-- Modale Box Configurator per Shopify con Gestione Extra Reali a Pagamento (F1) -->
<div id="shopify-box-modal" class="qd-modal-overlay">
  <div class="qd-modal">
    <div class="qd-modal-header">
      <h3 id="qd-modal-title">Componi Tropical Box</h3>
      <button type="button" class="qd-modal-close" id="qd-modal-close-btn">&times;</button>
    </div>
    <div class="qd-modal-body">
      <div>
        <span class="slot-counter" id="qd-slot-counter">0 / 3 piatti scelti</span>
        <p style="font-size: 12px; color: #666; margin: 0 0 10px 0;">
          Tutti i piatti scelti qui sotto sono inclusi nel prezzo fisso della box.
        </p>
      </div>

      <!-- Piatti selezionabili -->
      <div id="qd-plate-list"></div>

      <!-- Extra (Bevande, Salse, Bacchette) -->
      <div style="margin-top: 20px; padding-top: 15px; border-top: 1px solid #eee;">
        <h4 style="margin: 0 0 10px 0; font-size: 14px; font-weight: bold;">Vuoi da bere?</h4>
        <select id="qd-opt-drink" style="width: 100%; padding: 8px; border-radius: 8px; border: 1px solid #ccc; font-family: inherit;">
          <option value="none" data-price="0">Nessuna bevanda (+0,00 €)</option>
          <option value="coca" data-price="300" data-handle="coca-cola-vetro-33cl">Coca-Cola vetro 33cl (+3,00 €)</option>
          <option value="coca-zero" data-price="300" data-handle="coca-cola-zero-vetro-33cl">Coca-Cola Zero vetro 33cl (+3,00 €)</option>
          <option value="fanta" data-price="300" data-handle="fanta-vetro-33cl">Fanta Vetro 33cl (+3,00 €)</option>
          <option value="batti-becco" data-price="1600" data-handle="chardonnay-batti-becco">Chardonnay Batti Becco Bianco 0,75l (+16,00 €)</option>
        </select>
      </div>

      <div style="margin-top: 15px;">
        <h4 style="margin: 0 0 10px 0; font-size: 14px; font-weight: bold;">Vuoi la salsa soia?</h4>
        <select id="qd-opt-soia" style="width: 100%; padding: 8px; border-radius: 8px; border: 1px solid #ccc; font-family: inherit;">
          <option value="0" data-price="0">Nessuna (+0,00 €)</option>
          <option value="1" data-price="20" data-handle="salsa-soia">Salsa Soia (+0,20 €)</option>
          <option value="2" data-price="40" data-handle="salsa-soia" data-qty="2">Salsa Soia x2 (+0,40 €)</option>
          <option value="3" data-price="60" data-handle="salsa-soia" data-qty="3">Salsa Soia x3 (+0,60 €)</option>
          <option value="4" data-price="80" data-handle="salsa-soia" data-qty="4">Salsa Soia x4 (+0,80 €)</option>
        </select>
      </div>

      <div style="margin-top: 15px;">
        <h4 style="margin: 0 0 10px 0; font-size: 14px; font-weight: bold;">Vuoi la salsa Teriyaki?</h4>
        <select id="qd-opt-teriyaki" style="width: 100%; padding: 8px; border-radius: 8px; border: 1px solid #ccc; font-family: inherit;">
          <option value="0" data-price="0">Nessuna (+0,00 €)</option>
          <option value="1" data-price="100" data-handle="salsa-teriyaki">Salsa Teriyaki (+1,00 €)</option>
        </select>
      </div>

      <div style="margin-top: 15px;">
        <h4 style="margin: 0 0 10px 0; font-size: 14px; font-weight: bold;">Vuoi la salsa Agrodolce?</h4>
        <select id="qd-opt-agrodolce" style="width: 100%; padding: 8px; border-radius: 8px; border: 1px solid #ccc; font-family: inherit;">
          <option value="0" data-price="0">Nessuna (+0,00 €)</option>
          <option value="1" data-price="50" data-handle="salsa-agrodolce">Salsa Agrodolce (+0,50 €)</option>
        </select>
      </div>

      <div style="margin-top: 15px;">
        <h4 style="margin: 0 0 10px 0; font-size: 14px; font-weight: bold;">Quante bacchette ti servono? *</h4>
        <select id="qd-opt-chopsticks" style="width: 100%; padding: 8px; border-radius: 8px; border: 1px solid #ccc; font-family: inherit;">
          <option value="0">Nessuna</option>
          <option value="1" selected>1 paio</option>
          <option value="2">2 paia</option>
          <option value="3">3 paia</option>
          <option value="4">4 paia</option>
          <option value="5">5 paia</option>
        </select>
      </div>

      <div style="margin-top: 15px;">
        <label style="font-size: 12px; font-weight: bold; cursor: pointer;">
          <input type="checkbox" id="qd-opt-celiaco" data-price="50" data-handle="supplemento-senza-glutine"> Sei Celiaco? Soia Gluten Free e piatti separati (+0,50 €)
        </label>
      </div>
    </div>

    <div class="qd-modal-footer">
      <div>
        <span style="font-size: 11px; color: #888; display: block;">Totale box ed extra:</span>
        <span id="qd-modal-total" style="font-size: 18px; font-weight: bold; color: #17a5b9;">0,00 €</span>
      </div>
      <button type="button" class="btn-add-to-cart" id="qd-modal-submit" disabled>
        Seleziona tutti i piatti
      </button>
    </div>
  </div>
</div>

<script>
  let currentBox = {
    variantId: null,
    name: '',
    basePriceCents: 0,
    slotsRequired: 0,
    selectedPlates: [],
    drinkCents: 0,
    soiaCents: 0,
    teriyakiCents: 0,
    agrodolceCents: 0,
    celiacoCents: 0,
    chopsticks: 1,
    isLunch: false
  };

  const LUNCH_CHOICES = [
    "Uramaki Philadelphia 8 pz",
    "Uramaki Tempura 8 pz",
    "Olio's Uramaki 8 pz",
    "Uramaki Tonno Piccante 8 pz"
  ];

  const EVENING_CHOICES = [
    "Uramaki Salmone spicy (8 pezzi)",
    "Uramaki Philadelphia (8 pezzi)",
    "Tempura di Salmone (8 pezzi)",
    "Uramaki California (8 pezzi)",
    "Uramaki White (8 pezzi)",
    "Uramaki Tonno Pistacchio (8 pezzi)",
    "Uramaki Tonno Piccante (8 pezzi)",
    "Uramaki Ebi Tempura (8 pezzi)",
    "Olio's Uramaki (8 pezzi)",
    "Hot Salmon Roll (8 pezzi)",
    "Nigiri Salmone (3 pezzi)",
    "Nigiri Branzino (3 pezzi)"
  ];

  function openBoxModalFor(variantId, name, slots, priceCents, isLunch) {
    currentBox = {
      variantId: variantId,
      name: name,
      basePriceCents: priceCents,
      slotsRequired: slots,
      selectedPlates: [],
      drinkCents: 0,
      soiaCents: 0,
      teriyakiCents: 0,
      agrodolceCents: 0,
      celiacoCents: 0,
      chopsticks: 1,
      isLunch: isLunch
    };

    document.getElementById('qd-modal-title').textContent = name;
    document.getElementById('qd-opt-drink').selectedIndex = 0;
    document.getElementById('qd-opt-soia').selectedIndex = 0;
    document.getElementById('qd-opt-teriyaki').selectedIndex = 0;
    document.getElementById('qd-opt-agrodolce').selectedIndex = 0;
    document.getElementById('qd-opt-celiaco').checked = false;
    document.getElementById('qd-opt-chopsticks').value = '1';

    renderPlatesList();
    updatePlateCounts(); // F5: Reset esplicito contatori piatti
    updateBoxTotal();
    document.getElementById('shopify-box-modal').style.display = 'flex';
  }

  function closeBoxModal() {
    document.getElementById('shopify-box-modal').style.display = 'none';
  }

  const closeBtn = document.getElementById('qd-modal-close-btn');
  if (closeBtn) closeBtn.addEventListener('click', closeBoxModal);

  const modalOverlay = document.getElementById('shopify-box-modal');
  if (modalOverlay) {
    modalOverlay.addEventListener('click', (e) => {
      if (e.target === modalOverlay) closeBoxModal();
    });
  }

  // F4: Creazione sicura tramite DOM e addEventListener
  function renderPlatesList() {
    const container = document.getElementById('qd-plate-list');
    container.innerHTML = '';
    const pool = currentBox.isLunch ? LUNCH_CHOICES : EVENING_CHOICES;

    pool.forEach(plate => {
      const row = document.createElement('div');
      row.className = 'slot-plate-row';

      const label = document.createElement('span');
      label.textContent = plate;

      const ctrlDiv = document.createElement('div');

      const btnSub = document.createElement('button');
      btnSub.type = 'button';
      btnSub.className = 'slot-ctrl-btn';
      btnSub.textContent = '-';
      btnSub.addEventListener('click', () => modifyPlateCount(plate, -1));

      const countSpan = document.createElement('span');
      countSpan.className = 'plate-counter-span';
      countSpan.dataset.plate = plate;
      countSpan.style.display = 'inline-block';
      countSpan.style.width = '24px';
      countSpan.style.textAlign = 'center';
      countSpan.style.fontWeight = 'bold';
      countSpan.textContent = '0';

      const btnAdd = document.createElement('button');
      btnAdd.type = 'button';
      btnAdd.className = 'slot-ctrl-btn';
      btnAdd.textContent = '+';
      btnAdd.addEventListener('click', () => modifyPlateCount(plate, 1));

      ctrlDiv.appendChild(btnSub);
      ctrlDiv.appendChild(countSpan);
      ctrlDiv.appendChild(btnAdd);

      row.appendChild(label);
      row.appendChild(ctrlDiv);
      container.appendChild(row);
    });
  }

  function modifyPlateCount(plate, delta) {
    if (delta > 0 && currentBox.selectedPlates.length < currentBox.slotsRequired) {
      currentBox.selectedPlates.push(plate);
    } else if (delta < 0) {
      const idx = currentBox.selectedPlates.lastIndexOf(plate);
      if (idx !== -1) currentBox.selectedPlates.splice(idx, 1);
    }
    updatePlateCounts();
    updateBoxTotal();
  }

  function updatePlateCounts() {
    const counts = {};
    currentBox.selectedPlates.forEach(p => counts[p] = (counts[p] || 0) + 1);

    document.querySelectorAll('.plate-counter-span').forEach(el => {
      const p = el.dataset.plate;
      el.textContent = counts[p] || 0;
    });

    const badge = document.getElementById('qd-slot-counter');
    const curr = currentBox.selectedPlates.length;
    badge.textContent = `${curr} / ${currentBox.slotsRequired} piatti scelti`;
    badge.style.color = (curr === currentBox.slotsRequired) ? '#15b374' : '#17a5b9';
  }

  function updateBoxTotal() {
    const dOpt = document.getElementById('qd-opt-drink');
    const sOpt = document.getElementById('qd-opt-soia');
    const tOpt = document.getElementById('qd-opt-teriyaki');
    const aOpt = document.getElementById('qd-opt-agrodolce');
    const cVal = document.getElementById('qd-opt-celiaco').checked;

    currentBox.drinkCents = parseInt(dOpt.options[dOpt.selectedIndex].getAttribute('data-price') || '0', 10);
    currentBox.soiaCents = parseInt(sOpt.options[sOpt.selectedIndex].getAttribute('data-price') || '0', 10);
    currentBox.teriyakiCents = parseInt(tOpt.options[tOpt.selectedIndex].getAttribute('data-price') || '0', 10);
    currentBox.agrodolceCents = parseInt(aOpt.options[aOpt.selectedIndex].getAttribute('data-price') || '0', 10);
    currentBox.celiacoCents = cVal ? 50 : 0;
    currentBox.chopsticks = parseInt(document.getElementById('qd-opt-chopsticks').value, 10);

    const total = currentBox.basePriceCents + currentBox.drinkCents + currentBox.soiaCents + currentBox.teriyakiCents + currentBox.agrodolceCents + currentBox.celiacoCents;
    document.getElementById('qd-modal-total').textContent = formatMoney(total);

    const submitBtn = document.getElementById('qd-modal-submit');
    const missing = currentBox.slotsRequired - currentBox.selectedPlates.length;
    if (missing === 0) {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Aggiungi Box a Shopify';
    } else {
      submitBtn.disabled = true;
      submitBtn.textContent = `Mancano ${missing} piatti`;
    }
  }

  // Listener selettori extra
  ['qd-opt-drink', 'qd-opt-soia', 'qd-opt-teriyaki', 'qd-opt-agrodolce', 'qd-opt-celiaco', 'qd-opt-chopsticks'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.addEventListener('change', updateBoxTotal);
  });

  const submitBtn = document.getElementById('qd-modal-submit');
  if (submitBtn) {
    submitBtn.addEventListener('click', addConfiguredBoxToShopify);
  }

  // F1 & F3: Invio a Shopify con gestione Bundle Multi-Item
  // La Box viene inviata con la lista piatti nelle properties, e ogni extra a pagamento
  // viene inviato come riga reale addebitabile collegata tramite _box_ref
  async function addConfiguredBoxToShopify() {
    if (currentBox.selectedPlates.length !== currentBox.slotsRequired) {
      alert(`Seleziona esattamente ${currentBox.slotsRequired} piatti prima di aggiungere la box.`);
      return;
    }

    const boxRef = 'box-' + Date.now() + '-' + Math.random().toString(36).substr(2, 4);

    const counts = {};
    currentBox.selectedPlates.forEach(p => counts[p] = (counts[p] || 0) + 1);
    const platesText = Object.entries(counts).map(([k, v]) => `${v}x ${k}`).join(', ');

    const drinkOpt = document.getElementById('qd-opt-drink').selectedOptions[0];
    const soiaOpt = document.getElementById('qd-opt-soia').selectedOptions[0];
    const teriyakiOpt = document.getElementById('qd-opt-teriyaki').selectedOptions[0];
    const agrodolceOpt = document.getElementById('qd-opt-agrodolce').selectedOptions[0];
    const celiacoChecked = document.getElementById('qd-opt-celiaco').checked;

    const mainBoxItem = {
      id: currentBox.variantId,
      quantity: 1,
      properties: {
        'Piatti scelti': platesText,
        'Bacchette': currentBox.chopsticks + ' paia',
        '_box_ref': boxRef
      }
    };

    const extraItems = [];

    // Se è stata scelta una bevanda a pagamento
    if (drinkOpt && drinkOpt.value !== 'none') {
      mainBoxItem.properties['Bevanda inclusa'] = drinkOpt.text;
    }

    // Se sono state scelte salse a pagamento
    if (soiaOpt && soiaOpt.value !== '0') {
      mainBoxItem.properties['Salsa Soia'] = soiaOpt.text;
    }
    if (teriyakiOpt && teriyakiOpt.value !== '0') {
      mainBoxItem.properties['Salsa Teriyaki'] = teriyakiOpt.text;
    }
    if (agrodolceOpt && agrodolceOpt.value !== '0') {
      mainBoxItem.properties['Salsa Agrodolce'] = agrodolceOpt.text;
    }
    if (celiacoChecked) {
      mainBoxItem.properties['Senza Glutine'] = 'Sì (+0,50 €)';
    }

    const itemsToAdd = [mainBoxItem, ...extraItems];

    closeBoxModal();
    await addMultipleItemsToShopify(itemsToAdd);
  }
</script>
