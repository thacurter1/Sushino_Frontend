<div class="sushino-menu-section" style="margin-top: 20px;">

  <!-- AVVISO TOP SUSHINO & ORARI -->
  <div class="top-message">
    <div class="card" style="background: #fff; border-radius: 20px; padding: 20px; margin-bottom: 25px; box-shadow: 0 4px 15px rgba(0,0,0,0.04);">
      <p style="margin: 0 0 10px 0; font-size: 13px; line-height: 1.5;">
        <strong>Benvenuto su Sushino!</strong><br>
        Orari della cucina: domenica 12:30–15:00 e 19:30–23:30, da lunedì a mercoledì 19:30–23:30, da giovedì a sabato 19:30–23:00. Consegniamo in tutta Livorno.<br>
        <a href="{{ pages['allergeni'].url }}">Informazioni sugli allergeni</a><br>
        Hai bisogno di aiuto? <a href="tel:3520057782" style="color: #17a5b9; font-weight: bold;">Clicca qui</a> per ricevere assistenza.<br><br>
        Buona #sushinoexperience! 🛵 🍣 🌴
      </p>
    </div>
  </div>

  {% paginate collections by 50 %}
  {% assign sushino_box_ids = ',' %}
  {% assign sushino_lunch_ids = ',' %}
  {% assign sushino_gift_ids = ',' %}
  {% for collection in collections %}
    {% if collection.products_count > 0 and collection.handle != 'frontpage' %}
      {% assign c_title = collection.title | downcase %}
      {% assign c_handle = collection.handle | downcase %}
      {% if c_handle contains 'gift' or c_title contains 'gift' %}
        {% assign sushino_gift_ids = sushino_gift_ids | append: collection.id | append: ',' %}
      {% elsif c_handle contains 'pranzo' or c_title contains 'pranzo' or c_handle contains 'lunch' or c_title contains 'lunch' %}
        {% assign sushino_lunch_ids = sushino_lunch_ids | append: collection.id | append: ',' %}
      {% elsif c_handle contains 'box' or c_title contains 'box' %}
        {% assign sushino_box_ids = sushino_box_ids | append: collection.id | append: ',' %}
      {% endif %}
    {% endif %}
  {% endfor %}

  <details class="sushino-mobile-categories">
    <summary>Scegli una categoria <span aria-hidden="true">⌄</span></summary>
    <ul>
      {% for collection in collections %}
        {% if collection.products_count > 0 and collection.handle != 'frontpage' %}
          {% assign cid_token = ',' | append: collection.id | append: ',' %}
          {% if sushino_box_ids contains cid_token %}
            <li><a href="#cat-{{ collection.id }}">{{ collection.title | escape }}</a></li>
          {% endif %}
        {% endif %}
      {% endfor %}
      {% for collection in collections %}
        {% if collection.products_count > 0 and collection.handle != 'frontpage' %}
          {% assign cid_token = ',' | append: collection.id | append: ',' %}
          {% if sushino_lunch_ids contains cid_token %}
            <li><a href="#cat-{{ collection.id }}">{{ collection.title | escape }}</a></li>
          {% endif %}
        {% endif %}
      {% endfor %}
      {% for collection in collections %}
        {% if collection.products_count > 0 and collection.handle != 'frontpage' %}
          {% assign cid_token = ',' | append: collection.id | append: ',' %}
          {% if sushino_gift_ids contains cid_token %}
            <li><a href="#cat-{{ collection.id }}">{{ collection.title | escape }}</a></li>
          {% endif %}
        {% endif %}
      {% endfor %}
      {% for collection in collections %}
        {% if collection.products_count > 0 and collection.handle != 'frontpage' %}
          {% assign cid_token = ',' | append: collection.id | append: ',' %}
          {% unless sushino_box_ids contains cid_token or sushino_lunch_ids contains cid_token or sushino_gift_ids contains cid_token or collection.handle == 'salse' or collection.handle == 'vino-e-bibite' %}
            <li><a href="#cat-{{ collection.id }}">{{ collection.title | escape }}</a></li>
          {% endunless %}
        {% endif %}
      {% endfor %}
      {% assign sushino_tail_handles = 'salse,vino-e-bibite' | split: ',' %}
      {% for tail_handle in sushino_tail_handles %}
        {% assign collection = collections[tail_handle] %}
        {% if collection.products_count > 0 %}
          <li><a href="#cat-{{ collection.id }}">{{ collection.title | escape }}</a></li>
        {% endif %}
      {% endfor %}
    </ul>
  </details>
  <script>
    document.currentScript.previousElementSibling.addEventListener('click', function(event) {
      if (event.target.closest('a')) this.removeAttribute('open');
    });
  </script>

  <!-- BARRA CATEGORIE ORIZZONTALE (Tropical Box al 1° posto) -->
  <nav class="top-categories-bar" aria-label="Menu categorie">
    <ul class="top-categories-list">
      {% assign first_pill = true %}
      {% for collection in collections %}
        {% if collection.products_count > 0 and collection.handle != 'frontpage' %}
          {% assign cid_token = ',' | append: collection.id | append: ',' %}
          {% if sushino_box_ids contains cid_token %}
            <li{% if first_pill %} class="active"{% endif %}><a href="#cat-{{ collection.id }}">{{ collection.title | escape }}</a></li>
            {% assign first_pill = false %}
          {% endif %}
        {% endif %}
      {% endfor %}
      {% for collection in collections %}
        {% if collection.products_count > 0 and collection.handle != 'frontpage' %}
          {% assign cid_token = ',' | append: collection.id | append: ',' %}
          {% if sushino_lunch_ids contains cid_token %}
            <li><a href="#cat-{{ collection.id }}">{{ collection.title | escape }}</a></li>
          {% endif %}
        {% endif %}
      {% endfor %}
      {% for collection in collections %}
        {% if collection.products_count > 0 and collection.handle != 'frontpage' %}
          {% assign cid_token = ',' | append: collection.id | append: ',' %}
          {% if sushino_gift_ids contains cid_token %}
            <li><a href="#cat-{{ collection.id }}">{{ collection.title | escape }}</a></li>
          {% endif %}
        {% endif %}
      {% endfor %}
      {% for collection in collections %}
        {% if collection.products_count > 0 and collection.handle != 'frontpage' %}
          {% assign cid_token = ',' | append: collection.id | append: ',' %}
          {% unless sushino_box_ids contains cid_token or sushino_lunch_ids contains cid_token or sushino_gift_ids contains cid_token or collection.handle == 'salse' or collection.handle == 'vino-e-bibite' %}
            <li><a href="#cat-{{ collection.id }}">{{ collection.title | escape }}</a></li>
          {% endunless %}
        {% endif %}
      {% endfor %}
      {% assign sushino_tail_handles = 'salse,vino-e-bibite' | split: ',' %}
      {% for tail_handle in sushino_tail_handles %}
        {% assign collection = collections[tail_handle] %}
        {% if collection.products_count > 0 %}
          <li><a href="#cat-{{ collection.id }}">{{ collection.title | escape }}</a></li>
        {% endif %}
      {% endfor %}
    </ul>
  </nav>

  <!-- GRIGLIA PRODOTTI DINAMICA DA COLLEZIONI SHOPIFY (Tropical Box Sezione N.1) -->
  <div class="products card" style="background: #fff; border-radius: 20px; padding: 25px; box-shadow: 0 4px 15px rgba(0,0,0,0.04);">
    <h2 style="font-size: 20px; margin: 0 0 20px 0; color: #000;">Il Nostro Menu</h2>

    {% assign box_anchor_emitted = false %}
    {% for collection in collections %}
      {% if collection.products_count > 0 and collection.handle != 'frontpage' %}
        {% assign cid_token = ',' | append: collection.id | append: ',' %}
        {% if sushino_box_ids contains cid_token %}
          {% assign emit_cat33 = false %}
          {% unless box_anchor_emitted %}
            {% assign emit_cat33 = true %}
            {% assign box_anchor_emitted = true %}
          {% endunless %}
          {% render 'sushino-menu-category', collection: collection, is_first_box: emit_cat33 %}
        {% endif %}
      {% endif %}
    {% endfor %}

    {% for collection in collections %}
      {% if collection.products_count > 0 and collection.handle != 'frontpage' %}
        {% assign cid_token = ',' | append: collection.id | append: ',' %}
        {% if sushino_lunch_ids contains cid_token %}
          {% render 'sushino-menu-category', collection: collection, is_first_box: false %}
        {% endif %}
      {% endif %}
    {% endfor %}

    {% for collection in collections %}
      {% if collection.products_count > 0 and collection.handle != 'frontpage' %}
        {% assign cid_token = ',' | append: collection.id | append: ',' %}
        {% if sushino_gift_ids contains cid_token %}
          {% render 'sushino-menu-category', collection: collection, is_first_box: false %}
        {% endif %}
      {% endif %}
    {% endfor %}

    {% for collection in collections %}
      {% if collection.products_count > 0 and collection.handle != 'frontpage' %}
        {% assign cid_token = ',' | append: collection.id | append: ',' %}
        {% unless sushino_box_ids contains cid_token or sushino_lunch_ids contains cid_token or sushino_gift_ids contains cid_token or collection.handle == 'salse' or collection.handle == 'vino-e-bibite' %}
          {% render 'sushino-menu-category', collection: collection, is_first_box: false %}
        {% endunless %}
      {% endif %}
    {% endfor %}
    {% for tail_handle in sushino_tail_handles %}
      {% assign collection = collections[tail_handle] %}
      {% if collection.products_count > 0 %}
        {% render 'sushino-menu-category', collection: collection, is_first_box: false %}
      {% endif %}
    {% endfor %}
  </div>
  {{ paginate | default_pagination }}
  {% endpaginate %}
</div>

{% schema %}
{
  "name": "Sushino Menu Dinamico",
  "settings": []
}
{% endschema %}
