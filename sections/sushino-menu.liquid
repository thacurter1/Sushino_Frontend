<div class="sushino-menu-section" style="margin-top: 20px;">

  <!-- AVVISO TOP SUSHINO & ORARI -->
  <div class="top-message">
    <div class="card" style="background: #fff; border-radius: 20px; padding: 20px; margin-bottom: 25px; box-shadow: 0 4px 15px rgba(0,0,0,0.04);">
      <p style="margin: 0 0 10px 0; font-size: 13px; line-height: 1.5;">
        <strong>Benvenuto su Sushino!</strong><br>
        Orari della cucina: pranzo da giovedì a domenica 12:30–15:00; cena domenica, lunedì e martedì 19:30–23:30, da mercoledì a sabato 19:30–23:00. Consegniamo in tutta Livorno.<br>
        <a href="{{ pages['allergeni'].url }}">Informazioni sugli allergeni</a><br>
        Hai bisogno di aiuto? <a href="tel:3520057782" style="color: #17a5b9; font-weight: bold;">Clicca qui</a> per ricevere assistenza.<br><br>
        Buona #sushinoexperience! 🛵 🍣 🌴
      </p>
    </div>
  </div>

  {% paginate collections by 50 %}
  {% assign priority_handles = 'tropical-gift-card|tropical-box-pranzo|tropical-sushi-box|entree|nigiri-3-pezzi|gunkan-joe-2-pz|hosomaki-8-pz|uramaki-branzino-8-pz|uramaki-gambero-8-pz|uramaki-salmone-8-pz|uramaki-tonno-8-pz' | split: '|' %}
  {% assign selected_handles = '|' %}
  {% capture ordered_handles %}{% for handle in priority_handles %}{% assign category = collections[handle] %}{% if category.products_count > 0 %}{{ handle }}|{% assign selected_handles = selected_handles | append: handle | append: '|' %}{% endif %}{% endfor %}{% for category in collections %}{% assign handle_token = '|' | append: category.handle | append: '|' %}{% if category.products_count > 0 and category.handle != 'frontpage' and category.handle != 'salse' and category.handle != 'vino-e-bibite' %}{% unless selected_handles contains handle_token %}{{ category.handle }}|{% endunless %}{% endif %}{% endfor %}{% if collections['salse'].products_count > 0 %}salse|{% endif %}{% if collections['vino-e-bibite'].products_count > 0 %}vino-e-bibite|{% endif %}{% endcapture %}
  {% assign menu_handles = ordered_handles | split: '|' %}

  <details class="sushino-mobile-categories">
    <summary>Scegli una categoria <span aria-hidden="true">⌄</span></summary>
    <ul>
      {% for handle in menu_handles %}{% assign category = collections[handle] %}
        <li><a href="#cat-{{ category.id }}">{{ category.title | escape }}</a></li>
      {% endfor %}
    </ul>
  </details>
  <script>
    document.currentScript.previousElementSibling.addEventListener('click', function(event) {
      if (event.target.closest('a')) this.removeAttribute('open');
    });
  </script>

  <nav class="top-categories-bar" aria-label="Menu categorie">
    <ul class="top-categories-list">
      {% for handle in menu_handles %}{% assign category = collections[handle] %}
        <li{% if forloop.first %} class="active"{% endif %}><a href="#cat-{{ category.id }}">{{ category.title | escape }}</a></li>
      {% endfor %}
    </ul>
  </nav>

  <div class="products card" style="background: #fff; border-radius: 20px; padding: 25px; box-shadow: 0 4px 15px rgba(0,0,0,0.04);">
    <h2 style="font-size: 20px; margin: 0 0 20px 0; color: #000;">Il Nostro Menu</h2>
    {% for handle in menu_handles %}
      {% assign category = collections[handle] %}
      {% assign is_first_box = false %}
      {% if handle == 'tropical-sushi-box' %}{% assign is_first_box = true %}{% endif %}
      {% render 'sushino-menu-category', collection: category, is_first_box: is_first_box %}
    {% endfor %}
  </div>
  {{ paginate | default_pagination }}
  {% endpaginate %}
</div>

{% schema %}
{
  "name": "Sushino Menu Dinamico",
  "settings": []
}
{% endschema %}
