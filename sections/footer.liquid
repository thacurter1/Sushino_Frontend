<footer id="colophon" class="site-footer" style="background: #000; color: #fff; padding: 30px 0; margin-top: 50px;">
  <div class="container" style="text-align: center; font-size: 13px;">
    <p class="copyright" style="margin-bottom: 10px; color: #fab900;">
      {{ shop.name }} - Copyright &copy; {{ 'now' | date: "%Y" }} - Borgo dei Cappuccini 36, Livorno
    </p>
    <p class="terms" style="color: #888;">
      Consegna rapida a domicilio in tutta Livorno • Sushino Experience
    </p>
    <nav aria-label="Informazioni Sushino" style="display:flex; flex-wrap:wrap; justify-content:center; gap:8px 20px; margin-top:14px;">
      {% assign information_pages = 'contact,consegna-e-ritiro,allergeni' | split: ',' %}
      {% for page_handle in information_pages %}
        {% assign info_page = pages[page_handle] %}
        {% if info_page != blank %}
          <a style="color:#fff; text-decoration:underline;" href="{{ info_page.url }}">{{ info_page.title | escape }}</a>
        {% endif %}
      {% endfor %}
      {% for policy in shop.policies %}
        {% if policy != blank %}
          <a style="color:#fff; text-decoration:underline;" href="{{ policy.url }}">{{ policy.title | escape }}</a>
        {% endif %}
      {% endfor %}
    </nav>
  </div>
</footer>

{% schema %}
{
  "name": "Footer Sushino",
  "settings": []
}
{% endschema %}
