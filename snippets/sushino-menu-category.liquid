{% comment %}
  Singola categoria del menu Sushino.
  Parametri:
  - collection: collezione Shopify da renderizzare
  - is_first_box: (opzionale) se true aggiunge anche l'ancora #cat33
{% endcomment %}
<div class="category-products" id="cat-{{ collection.id }}" style="margin-bottom: 40px;">
  {% if is_first_box %}
    <span id="cat33" aria-hidden="true"></span>
  {% endif %}
  <div class="category-title" style="margin-bottom: 20px; border-bottom: 2px solid #17a5b9; padding-bottom: 8px;">
    <h3 style="margin: 0; font-size: 18px; color: #17a5b9;">{{ collection.title | escape }}</h3>
    {% if collection.description != blank %}
      <p style="margin: 6px 0 0 0; font-size: 12px; color: #666;">{{ collection.description }}</p>
    {% endif %}
  </div>

  <div class="products-grid-layout">
    {% assign is_gift_collection = false %}
    {% if collection.handle contains 'gift' or collection.title contains 'Gift' %}
      {% assign is_gift_collection = true %}
    {% endif %}
    {% assign gift_card_rendered = false %}

    {% for product in collection.products limit: 50 %}
      {% assign title_down = product.title | downcase %}
      {% assign is_gift_product = false %}
      {% if is_gift_collection or product.tags contains 'gift-card-slider' or product.handle contains 'gift-card' or title_down contains 'gift card' %}
        {% assign is_gift_product = true %}
      {% endif %}

      {% if is_gift_product %}
        {% if is_gift_collection %}
          {% unless gift_card_rendered %}
            {% render 'sushino-gift-card-slider', product: product, collection_products: collection.products %}
            {% assign gift_card_rendered = true %}
          {% endunless %}
        {% else %}
          {% render 'sushino-gift-card-slider', product: product %}
        {% endif %}
      {% else %}
        {% assign is_box = false %}
        {% assign slots = 0 %}
        {% if product.tags contains 'box-3' %}
          {% assign is_box = true %}
          {% assign slots = 3 %}
        {% elsif product.tags contains 'box-5' %}
          {% assign is_box = true %}
          {% assign slots = 5 %}
        {% elsif product.tags contains 'box-8' %}
          {% assign is_box = true %}
          {% assign slots = 8 %}
        {% elsif product.tags contains 'box-lunch' %}
          {% assign is_box = true %}
          {% assign slots = 1 %}
        {% endif %}

        {% if product.handle == 'box-vegana' %}{% assign is_box = false %}{% assign slots = 0 %}{% endif %}
        {% assign active_variant = product.first_available_variant %}
        <div class="product-grid-card">
          <div class="product-thumb-top">
            {% render 'sushino-product-image', product: product %}
          </div>
          <div class="product-body-content">
            <div>
              <div class="product-name">{{ product.title | escape }}</div>
              <div class="product-price-badge">{% if active_variant %}{{ active_variant.price | money }}{% else %}{{ product.price | money }}{% endif %}</div>
              <div class="product-description">
                {{ product.description | strip_html | truncate: 120 }}
              </div>
            </div>

            {% if active_variant %}
              {% if is_box %}
                <button type="button" class="btn-add-to-cart js-configure-box" data-variant-id="{{ active_variant.id }}" data-product-title="{{ product.title | escape }}" data-slots="{{ slots }}" data-price-cents="{{ active_variant.price }}" data-is-lunch="{% if product.tags contains 'box-lunch' %}true{% else %}false{% endif %}">
                  Configura e Aggiungi
                </button>
              {% else %}
                <button type="button" class="btn-add-to-cart js-add-product" data-variant-id="{{ active_variant.id }}">
                  Aggiungi al Carrello
                </button>
              {% endif %}
            {% else %}
              <button type="button" class="btn-add-to-cart" disabled>Non disponibile</button>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
  {% if collection.products_count > 50 %}
    <p><a href="{{ collection.url }}">Vedi tutti i prodotti di {{ collection.title | escape }}</a></p>
  {% endif %}
</div>
