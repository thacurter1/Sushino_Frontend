      {% assign sushino_photo_asset = 'sushino-gift-card-10.svg' %}
      {% assign sushino_photo_width = 800 %}
      {% assign sushino_photo_height = 600 %}
  {% endcase %}
  {% if sushino_photo_asset != blank %}
    <img loading="lazy" width="{{ sushino_photo_width }}" height="{{ sushino_photo_height }}" src="{{ sushino_photo_asset | asset_url }}" alt="{{ product.title | escape }}">
  {% else %}
    <img loading="lazy" width="200" height="35" src="{{ 'logo-w.png' | asset_url }}" alt="Foto del prodotto non disponibile" style="object-fit: contain; padding: 30px; background: #17a5b9;">
  {% endif %}
{% endif %}
