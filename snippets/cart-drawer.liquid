<!-- Cassetto Laterale Carrello Connesso a Shopify Cart API (/cart.js) -->
<style>
  .cart-drawer-panel { overflow-y: auto; }
  .cart-drawer-body { flex: 0 0 auto; overflow: visible; }
  .cart-drawer-footer { flex: 0 0 auto; }
  #sushino-service-fields[hidden] { display:none !important; }
  [data-sushino-checkout]:disabled { opacity:.6; cursor:wait; }
</style>
<div class="cart-drawer-backdrop" id="shopify-cart-backdrop" data-cart-backdrop>
  <div class="cart-drawer-panel">
    <div class="cart-drawer-header">
      <h3>Il tuo Carrello</h3>
      <button type="button" class="cart-drawer-close" data-close-cart aria-label="Chiudi il carrello">&times;</button>
    </div>
    <div class="cart-drawer-body" id="shopify-cart-items-container">
      <p id="shopify-cart-empty-msg" style="color: #666; font-size: 13px;">Caricamento carrello...</p>
    </div>
    <div class="cart-drawer-footer" id="shopify-cart-footer" style="display: none;">
      <div style="display: flex; justify-content: space-between; font-weight: bold; margin-bottom: 15px; font-size: 16px;">
        <span>Subtotale prodotti:</span>
        <span id="shopify-cart-total-display" style="color: #17a5b9;">0,00 €</span>
      </div>
      <fieldset id="sushino-service-fields" style="border:0;padding:0;margin:0 0 16px;display:grid;gap:10px">
        <legend style="font-weight:700;margin-bottom:10px">Come e quando vuoi ricevere l’ordine?</legend>
        <label for="sushino-service-mode">Modalità</label>
        <select id="sushino-service-mode" required style="width:100%;min-height:44px;font:inherit"><option value="">Scegli ritiro o consegna</option><option value="ritiro">Ritiro al locale — gratuito</option><option value="delivery">Consegna a domicilio — 2 €</option></select>
        <label for="sushino-service-date">Giorno</label><input id="sushino-service-date" type="date" required style="width:100%;min-height:44px;font:inherit;box-sizing:border-box">
        <label for="sushino-service-slot">Fascia oraria</label><select id="sushino-service-slot" required style="width:100%;min-height:44px;font:inherit"><option value="">Scegli prima il giorno</option></select>
        <small>Fasce di 30 minuti, con almeno 30 minuti di anticipo. Nel checkout scegli lo stesso metodo: ritiro oppure consegna.</small>
        <p id="sushino-service-error" role="alert" style="color:#a01828;margin:0"></p>
      </fieldset>
      <button type="button" data-sushino-checkout data-lunch-handles="{{ collections['tropical-box-pranzo'].products | map: 'handle' | join: ',' | escape }}" data-root="{{ routes.root_url }}" data-checkout-url="{{ routes.root_url }}checkout" class="btn-add-to-cart" style="display: block; width:100%; border:0; font:inherit; padding:14px; text-align:center; box-sizing:border-box;">
        Procedi al Checkout Shopify ➔
      </button>
      <noscript>Attiva JavaScript per scegliere l’orario e proseguire con l’ordine.</noscript>
    </div>
  </div>
</div>

<!-- Floating Cart Button -->
<button type="button" class="floating-cart-pill" id="shopify-floating-cart-btn" data-open-cart aria-label="Apri il carrello" style="border: 0; font-family: inherit;">
  <span>🛒 Carrello</span>
  <span class="floating-cart-badge" id="shopify-floating-count">{{ cart.item_count }}</span>
  <span id="shopify-floating-total" style="margin-left: 4px;">{{ cart.total_price | money }}</span>
</button>

<script>
  const SHOPIFY_ROOT_URL = {{ routes.root_url | json }};
  const shopifyEndpoint = (path) => `${SHOPIFY_ROOT_URL}${path}`;

  document.addEventListener('click', (event) => {
    if (event.target.closest('[data-open-cart]')) {
      openShopifyCartDrawer();
      return;
    }
    if (event.target.closest('[data-close-cart]') || event.target === document.getElementById('shopify-cart-backdrop')) {
      closeShopifyCartDrawer();
      return;
    }
    const boxButton = event.target.closest('.js-configure-box');
    if (boxButton) {
      openBoxModalFor(boxButton.dataset.variantId, boxButton.dataset.productTitle, parseInt(boxButton.dataset.slots, 10), parseInt(boxButton.dataset.priceCents, 10), boxButton.dataset.isLunch === 'true');
      return;
    }
    const productButton = event.target.closest('.js-add-product');
    if (productButton) {
      addProductToShopify(productButton.dataset.variantId, 1);
      return;
    }
    const giftButton = event.target.closest('.js-add-gift-card');
    if (giftButton && !giftButton.disabled) {
      const card = giftButton.closest('.sushino-gift-card-item');
      const slider = card ? card.querySelector('.js-gift-slider') : null;
      const syncState = slider ? syncGiftCardSlider(slider) : null;
      const variantId = (syncState && syncState.variantId) || giftButton.dataset.variantId;
      const amountCents = (syncState && syncState.priceCents) || parseInt(giftButton.dataset.selectedCents || '3000', 10);
      if (variantId) {
        addProductToShopify(variantId, 1, {
          'Importo Gift Card': formatMoney(amountCents)
        });
      }
    }
  });

  document.addEventListener('change', (event) => {
    const select = event.target.closest('.js-product-variant');
    if (!select) return;
    const card = select.closest('.product-grid-card');
    const option = select.selectedOptions[0];
    if (!card || !option) return;
    const button = card.querySelector('.js-add-product');
    const price = card.querySelector('.product-price-badge');
    if (button) { button.dataset.variantId = option.value; button.disabled = option.disabled; }
    if (price) price.textContent = formatMoney(Number(option.dataset.priceCents));
  });

  function resolveGiftVariant(variants, targetCents) {
    if (!Array.isArray(variants) || variants.length === 0) return null;
    const availableVariants = variants.filter((v) => v && v.available);
    const pool = availableVariants.length > 0 ? availableVariants : variants;
    const exact = pool.find((v) => Number(v.priceCents) === targetCents);
    if (exact) return { variant: exact, isExact: true };
    let closest = pool[0];
    let minDiff = Math.abs(Number(closest.priceCents) - targetCents);
    for (const v of pool) {
      const diff = Math.abs(Number(v.priceCents) - targetCents);
      if (diff < minDiff) {
        minDiff = diff;
        closest = v;
      }
    }
    return { variant: closest, isExact: false };
  }

  function syncGiftCardSlider(slider) {
    const card = slider.closest('.sushino-gift-card-item');
    if (!card) return null;
    let variants = [];
    try {
      variants = JSON.parse(slider.dataset.giftVariants || '[]');
    } catch (e) {
      variants = [];
    }
    const minEur = parseInt(slider.min || '30', 10);
    const maxEur = parseInt(slider.max || '200', 10);
    const selectedEur = parseInt(slider.value || String(minEur), 10);
    const progressPct = Math.max(0, Math.min(100, ((selectedEur - minEur) / (maxEur - minEur)) * 100));
    if (slider.style && typeof slider.style.setProperty === 'function') {
      slider.style.setProperty('--slider-progress', `${progressPct}%`);
    }

    const targetCents = selectedEur * 100;
    const resolved = resolveGiftVariant(variants, targetCents);

    const valueEl = card.querySelector('.js-gift-slider-value');
    const badgeEl = card.querySelector('.js-gift-price-badge');
    const noteEl = card.querySelector('.js-gift-slider-note');
    const btn = card.querySelector('.js-add-gift-card');

    if (!resolved || !resolved.variant) {
      if (valueEl) valueEl.textContent = formatMoney(targetCents);
      if (badgeEl) badgeEl.textContent = formatMoney(targetCents);
      if (btn) btn.disabled = true;
      return null;
    }

    const activeVariant = resolved.variant;
    const displayCents = resolved.isExact ? targetCents : Number(activeVariant.priceCents);
    if (valueEl) valueEl.textContent = formatMoney(targetCents);
    if (badgeEl) badgeEl.textContent = formatMoney(displayCents);

    if (noteEl) {
      if (resolved.isExact) {
        noteEl.hidden = true;
        noteEl.textContent = '';
      } else {
        noteEl.hidden = false;
        noteEl.textContent = `Taglio disponibile più vicino: ${formatMoney(displayCents)} (${activeVariant.title || ''})`.trim();
      }
    }

    if (btn) {
      btn.dataset.variantId = String(activeVariant.id);
      btn.dataset.selectedCents = String(displayCents);
      btn.disabled = !activeVariant.available;
      btn.textContent = activeVariant.available
        ? `Aggiungi Gift Card (${formatMoney(displayCents)})`
        : 'Importo non disponibile';
    }

    return {
      variantId: activeVariant.id,
      priceCents: displayCents,
      isExact: resolved.isExact
    };
  }

  document.addEventListener('input', (event) => {
    const slider = event.target.closest('.js-gift-slider');
    if (slider) syncGiftCardSlider(slider);
  });

  document.addEventListener('change', (event) => {
    const slider = event.target.closest('.js-gift-slider');
    if (slider) syncGiftCardSlider(slider);
  });

  document.querySelectorAll('.js-gift-slider').forEach((slider) => {
    syncGiftCardSlider(slider);
  });

  function formatMoney(cents) {
    return (cents / 100).toLocaleString('it-IT', { style: 'currency', currency: 'EUR' });
  }

  function openShopifyCartDrawer() {
    document.getElementById('shopify-cart-backdrop').style.display = 'flex';
    fetchShopifyCart();
  }

  function closeShopifyCartDrawer() {
    document.getElementById('shopify-cart-backdrop').style.display = 'none';
  }

  // Chiusura con tasto Esc
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeShopifyCartDrawer();
  });

  // Leggi carrello reale da Shopify API
  async function fetchShopifyCart() {
    try {
      const res = await fetch(shopifyEndpoint('cart.js'));
      if (!res.ok) throw new Error("Errore durante il caricamento del carrello");
      const cart = await res.json();
      renderShopifyCart(cart);
    } catch (err) {
      console.error("Errore fetch carrello Shopify:", err);
    }
  }

  // F7: Render del carrello con textContent (prevenzione DOM XSS e caratteri speciali)
  // F9: Rimozione basata su item.key stabile anziché indice posizionale
  function renderShopifyCart(cart) {
    document.dispatchEvent(new CustomEvent('sushino:cart-loaded', { detail: cart }));
    const container = document.getElementById('shopify-cart-items-container');
    const footer = document.getElementById('shopify-cart-footer');
    const totalEl = document.getElementById('shopify-cart-total-display');
    const badge = document.getElementById('cart-badge-count');
    const floatCount = document.getElementById('shopify-floating-count');
    const floatTotal = document.getElementById('shopify-floating-total');

    badge.textContent = cart.item_count;
    floatCount.textContent = cart.item_count;
    floatTotal.textContent = formatMoney(cart.total_price);

    if (cart.items.length === 0) {
      container.innerHTML = '<p style="color: #666; font-size: 13px;">Nessun prodotto nel carrello.</p>';
      footer.style.display = 'none';
      return;
    }

    footer.style.display = 'block';
    totalEl.textContent = formatMoney(cart.total_price);
    container.innerHTML = '';

    const boxRefs = new Set(cart.items
      .filter((item) => item.properties?._box_ref && item.properties['Piatti scelti'])
      .map((item) => item.properties._box_ref));

    cart.items.forEach((item) => {
      const itemRow = document.createElement('div');
      itemRow.className = 'cart-box-item';

      const titleRow = document.createElement('div');
      titleRow.className = 'cart-box-title';

      const titleSpan = document.createElement('span');
      titleSpan.textContent = item.product_title;

      const priceSpan = document.createElement('span');
      priceSpan.style.color = '#17a5b9';
      priceSpan.textContent = formatMoney(item.final_line_price);

      titleRow.appendChild(titleSpan);
      titleRow.appendChild(priceSpan);
      itemRow.appendChild(titleRow);

      if (item.properties) {
        for (const [key, value] of Object.entries(item.properties)) {
          if (value && !key.startsWith('_')) {
            const propDiv = document.createElement('div');
            propDiv.style.fontSize = '11px';
            propDiv.style.color = '#666';
            propDiv.textContent = `• ${key}: ${value}`;
            itemRow.appendChild(propDiv);
          }
        }
      }

      const actionsDiv = document.createElement('div');
      actionsDiv.style.marginTop = '6px';
      actionsDiv.style.display = 'flex';
      actionsDiv.style.justifyContent = 'space-between';
      actionsDiv.style.alignItems = 'center';

      const qtySpan = document.createElement('span');
      qtySpan.style.fontSize = '12px';
      qtySpan.style.color = '#444';
      qtySpan.textContent = `Quantità: ${item.quantity}`;

      actionsDiv.appendChild(qtySpan);

      const boxRef = item.properties?._box_ref;
      const isBox = boxRefs.has(boxRef) && Boolean(item.properties['Piatti scelti']);
      if (isBox || !boxRefs.has(boxRef)) {
        const removeBtn = document.createElement('span');
        removeBtn.className = 'cart-remove-btn';
        removeBtn.textContent = isBox ? 'Rimuovi box ed extra' : 'Rimuovi';
        removeBtn.addEventListener('click', () => {
          const keys = isBox
            ? cart.items.filter((line) => line.properties?._box_ref === boxRef).map((line) => line.key)
            : [item.key];
          return removeShopifyItems(keys);
        });
        actionsDiv.appendChild(removeBtn);
      }

      itemRow.appendChild(actionsDiv);

      container.appendChild(itemRow);
    });
  }

  let cartRemovalPending = false;

  async function removeShopifyItems(keys) {
    if (cartRemovalPending) return;
    cartRemovalPending = true;
    try {
      const multiple = keys.length > 1;
      const body = multiple
        ? { updates: Object.fromEntries(keys.map((key) => [key, 0])) }
        : { id: keys[0], quantity: 0 };
      const res = await fetch(shopifyEndpoint(multiple ? 'cart/update.js' : 'cart/change.js'), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });
      if (!res.ok) throw new Error("Errore aggiornamento carrello");
      const cart = await res.json();
      renderShopifyCart(cart);
    } catch (e) {
      console.error(e);
      alert("Impossibile aggiornare il carrello. Riprova.");
    } finally {
      cartRemovalPending = false;
    }
  }

  // F8: Aggiunta singolo prodotto
  async function addProductToShopify(variantId, qty = 1, properties = {}) {
    await addMultipleItemsToShopify([{
      id: variantId,
      quantity: qty,
      properties: properties
    }]);
  }

  // F1: Aggiunta multipla per Box + Extra reali (invia articoli separati a pagamento nell'endpoint nativo /cart/add.js)
  async function addMultipleItemsToShopify(itemsArray) {
    try {
      const res = await fetch(shopifyEndpoint('cart/add.js'), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: itemsArray })
      });
      if (!res.ok) {
        const errorData = await res.json();
        alert("Impossibile aggiungere gli articoli: " + (errorData.description || "verificare la disponibilità nel negozio."));
        return;
      }
      openShopifyCartDrawer();
    } catch (e) {
      console.error("Errore aggiunta carrello multiplo:", e);
      alert("Errore di connessione con il negozio Shopify.");
    }
  }
</script>

<script src="{{ 'sushino-service-time.js' | asset_url }}" defer></script>
